---
// Shared lightbox: render once per page that has any .media-thumb buttons
// (gallery thumbs and/or the infobox cover). Wires click / arrows / Esc.
---
<div class="lightbox" id="lightbox" hidden>
  <button class="lb-btn lb-close" type="button" aria-label="關閉">×</button>
  <button class="lb-btn lb-prev" type="button" aria-label="上一張">‹</button>
  <button class="lb-btn lb-next" type="button" aria-label="下一張">›</button>
  <figure class="lb-fig" onclick="event.stopPropagation()">
    <img class="lb-img" src="" alt="" decoding="async" />
    <figcaption class="lb-cap"></figcaption>
  </figure>
</div>
<script is:inline>
  (() => {
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const img = lb.querySelector('.lb-img');
    const cap = lb.querySelector('.lb-cap');
    // Candidate nodes in document order. The infobox cover is almost always a
    // duplicate of some gallery thumb (coverOf picks from the same media list),
    // so dedupe by data-full: keep one entry per image for the loop, and map a
    // duplicate node's click onto the kept entry's index.
    const nodes = [...document.querySelectorAll('.cover-img, .media-thumb, .fig-img')];
    if (!nodes.length) return;
    const thumbs = [];
    const idxOf = new Map();
    // Duplicates carry different metadata: an in-body .fig-img only knows its
    // caption, while the gallery thumb also has source / magazine-issue data.
    // Keep the first node for ordering, but fold in whatever fields it lacks so
    // the lightbox shows the full footer no matter which copy was clicked.
    // Prefer the gallery/cover copy over an in-body .fig-img: only the gallery
    // carries source + magazine-issue data, and its caption is the one those
    // fields were derived from (a body caption is usually worded differently, so
    // mixing the two would break the「刊名＋期號」replace below).
    for (const n of nodes) {
      const key = n.dataset.full;
      if (!idxOf.has(key)) { idxOf.set(key, thumbs.length); thumbs.push(n); continue; }
      const i = idxOf.get(key);
      if (!thumbs[i].dataset.source && n.dataset.source) thumbs[i] = n;
    }
    let i = -1;
    // Bumped on every show()/close() so a slow full-size load can't overwrite a
    // newer picture when it finally arrives.
    let token = 0;
    const fig = lb.querySelector('.lb-fig');
    // The gallery serves a separate (much smaller) thumb file, so the full image
    // only starts downloading on click. Paint the already-cached thumb first and
    // swap in the full one when it lands, rather than opening onto a blank frame.
    const showImage = (full, thumb) => {
      const mine = ++token;
      if (!thumb || thumb === full) {
        img.src = full;
        fig.classList.toggle('is-loading', !img.complete);
        img.onload = () => { if (mine === token) fig.classList.remove('is-loading'); };
        return;
      }
      img.src = thumb;
      fig.classList.add('is-loading');
      const full_ = new Image();
      full_.onload = () => {
        if (mine !== token) return;
        img.src = full;
        fig.classList.remove('is-loading');
      };
      full_.src = full;
    };
    const show = (n) => {
      i = (n + thumbs.length) % thumbs.length;
      const t = thumbs[i];
      showImage(t.dataset.full, t.querySelector('img')?.currentSrc || t.querySelector('img')?.src);
      img.alt = t.dataset.caption || '';
      const parts = [];
      if (t.dataset.caption) {
        // Linkify the「刊名＋期號」substring in place (grid caption stays plain;
        // the link only surfaces here in the lightbox), so it isn't repeated.
        let cap = t.dataset.caption;
        if (t.dataset.magUrl && t.dataset.magLabel) {
          cap = cap.replace(t.dataset.magLabel, `<a href="${t.dataset.magUrl}" target="_blank" rel="noopener nofollow">${t.dataset.magLabel}</a>`);
        }
        parts.push(`<span class="c">${cap}</span>`);
      }
      if (t.dataset.source) {
        const src = t.dataset.sourceUrl
          ? `<a href="${t.dataset.sourceUrl}" target="_blank" rel="noopener">${t.dataset.source}</a>`
          : t.dataset.source;
        parts.push(`<span class="s">來源：${src}${t.dataset.credit ? '／' + t.dataset.credit : ''}</span>`);
      }
      cap.innerHTML = parts.join('');
      lb.hidden = false;
    };
    const close = () => { token += 1; lb.hidden = true; img.src = ''; fig.classList.remove('is-loading'); };
    nodes.forEach((t) => t.addEventListener('click', () => show(idxOf.get(t.dataset.full))));
    lb.addEventListener('click', close);
    lb.querySelector('.lb-close').addEventListener('click', (e) => { e.stopPropagation(); close(); });
    lb.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
    lb.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(i - 1);
      else if (e.key === 'ArrowRight') show(i + 1);
    });
  })();
</script>

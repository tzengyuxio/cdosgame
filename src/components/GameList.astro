---
import { gameUrl } from '../lib/links.js';
import { genreLabel, vendorLabel } from '../lib/labels.js';
const { games } = Astro.props;
---
<ul class="results">
  {games.map(g => (
    <li><a href={gameUrl(g.id)}>
      <span class="r-title">{g.title_zh}</span>
      {g.published === false && <span class="r-draft">未發佈</span>}
      {g.media?.length > 0 && (
        <span class="r-img" title={`含圖 ${g.media.length} 張`} aria-label={`含圖 ${g.media.length} 張`}>📷{g.media.length > 1 && ` ${g.media.length}`}</span>
      )}
      <span class="r-id">{g.id}</span>
      <span class="r-meta">{g.year ?? '—'} · {vendorLabel(g)} · {genreLabel(g.genre) || '—'}</span>
    </a></li>
  ))}
</ul>

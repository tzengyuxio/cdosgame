---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { groupBy, distinctValues, vendorsOf, decadeOf, yearRange } from '../lib/gamesQuery.js';
import { seriesUrl, decadeUrl, gameUrl, companyUrl, teamUrl, personUrl, topicUrl, withBase } from '../lib/links.js';
import { coverOf, thumbUrl } from '../lib/media.js';
import { pickFeaturedAds } from '../lib/featuredAds.js';
import { websiteJsonLd, datasetJsonLd } from '../lib/jsonld.js';
import { latestModified, lastModified } from '../lib/gitdates.js';

const games = (await getCollection('games', e => import.meta.env.PROD ? e.data.published : true)).map(e => e.data);
const total = games.length;
const bySeries = groupBy(games, g => g.series);
const seriesCount = bySeries.size;
const companies = distinctValues(games, vendorsOf);
const featSeries = [...bySeries.entries()]
  .map(([name, list]) => ({ name, list, range: yearRange(list) }))
  .sort((a, b) => b.list.length - a.list.length).slice(0, 8);
const decades = distinctValues(games, g => decadeOf(g.year)).sort((a, b) => a.value.localeCompare(b.value));
// Featured cover wall: all entries carrying a box-front scan form the pool; the
// client does weighted sampling on each visit. SSR renders a stable, high-weight
// subset as the no-JS fallback.
const WALL_N = 16;
// Localization weights: 原生中文/中文化 covers are scarce (~70 with box-front) vs
// abundant packaging scans (~450), so a mild ×3 would still leave packaging ~68%.
// ×8 lifts native+localized exposure to ~55% of the 16 tiles — the intended target.
const COVER_WEIGHTS = { native: 8, localized: 8, packaging: 1, foreign: 1 };
const coverWeight = g => COVER_WEIGHTS[g.localization_level] ?? 1;
const coverGames = games.filter(g => (g.media || []).some(m => m.kind === 'box-front'));
const toCard = g => ({ u: gameUrl(g.id), img: thumbUrl('games', g.id, coverOf(g.media).src), t: g.title_zh, w: coverWeight(g) });
const coverPool = coverGames.map(toCard);
const featured = [...coverGames]
  .sort((a, b) => coverWeight(b) - coverWeight(a) || (b.media?.length || 0) - (a.media?.length || 0))
  .slice(0, WALL_N).map(toCard);
const adGroups = games.map(g => ({
  id: g.id,
  u: gameUrl(g.id),
  t: g.title_zh,
  ads: (g.media || [])
    .filter(m => m.kind === 'ad' && m.src)
    .map(m => ({ img: thumbUrl('games', g.id, m.src) })),
})).filter(g => g.ads.length > 0);
const featuredAds = pickFeaturedAds(adGroups, WALL_N, () => 0.5);
const adGroupsJson = JSON.stringify(adGroups).replaceAll('<', '\\u003c');
// 最近更新 feed: newest-edited entries across all entity types, keyed by each
// content file's last git-commit date. Empty (section hidden) on shallow clones
// where git history is unavailable.
const trunc = (s, n = 34) => (s && s.length > n ? s.slice(0, n) + '…' : (s || ''));
const FEED_TYPES = [
  { col: 'games', dir: 'games', key: 'game', emoji: '🎮', label: '遊戲', url: gameUrl, name: d => d.title_zh, sub: d => [d.year, d.developer].filter(Boolean).join(' · ') },
  { col: 'companies', dir: 'companies', key: 'company', emoji: '🏢', label: '廠商', url: companyUrl, name: d => d.name_zh, sub: d => d.name_en || '' },
  { col: 'series', dir: 'series', key: 'series', emoji: '📚', label: '系列', url: seriesUrl, name: d => d.name_zh, sub: d => trunc(d.summary) },
  { col: 'teams', dir: 'teams', key: 'team', emoji: '👥', label: '團隊', url: teamUrl, name: d => d.name_zh, sub: d => d.name_en || '' },
  { col: 'people', dir: 'people', key: 'person', emoji: '👤', label: '人物', url: personUrl, name: d => d.name_zh, sub: d => d.name_en || '' },
  { col: 'topics', dir: 'topics', key: 'topic', emoji: '🔖', label: '專題', url: topicUrl, name: d => d.name_zh, sub: d => trunc(d.summary) },
];
const feed = [];
for (const t of FEED_TYPES) {
  const entries = await getCollection(t.col, e => import.meta.env.PROD ? e.data.published : true);
  for (const e of entries) {
    const mod = lastModified(`content/${t.dir}/${e.id}.md`);
    if (!mod) continue;
    feed.push({ url: t.url(e.id), type: t.key, emoji: t.emoji, label: t.label, name: t.name(e.data), sub: t.sub(e.data), date: mod.slice(0, 10), iso: mod, img: (e.data.media || []).length > 0 });
  }
}
feed.sort((a, b) => b.iso.localeCompare(a.iso) || a.name.localeCompare(b.name, 'zh-Hant'));
// Anti-flood: a bulk import lands many files on one commit/day. Cap each
// (day × type) group so no single batch can wash out the whole feed.
const RECENT_TOTAL = 15, PER_GROUP = 3;
const groupSeen = {};
const recent = [];
for (const f of feed) {
  const k = `${f.date}|${f.label}`;
  if ((groupSeen[k] = (groupSeen[k] || 0) + 1) > PER_GROUP) continue;
  recent.push(f);
  if (recent.length >= RECENT_TOTAL) break;
}
const site = (Astro.site?.href || 'https://cdosgame.simagame.me/').replace(/\/$/, '');
const desc = `盡可能齊全、重考據的中文 DOS 時代遊戲百科——已收錄 ${total} 款，涵蓋 ${seriesCount} 個系列、${companies.length} 家廠商，並附廠商、系列、人物與考據資料。`;
const jsonLd = [websiteJsonLd({ site, description: desc }), datasetJsonLd({ site, description: desc, count: total, dateModified: latestModified() })];
---
<Base title="中文 DOS 遊戲資料庫" description={desc} jsonLd={jsonLd}>
  <section class="hero">
    <h1>中文 DOS 遊戲資料庫</h1>
    <p class="lead">盡可能齊全、重考據的中文 DOS 時代遊戲百科。</p>
    <p class="entity-sub">已收錄 {total} 款 · {seriesCount} 系列 · {companies.length} 廠商</p>
    <a class="btn" href={withBase('/games')}>瀏覽全部</a> <button class="btn" id="random">隨機探索</button>
  </section>

  {adGroups.length > 0 ? (
    <h2 class="featured-heading">
      <span class="featured-tablist" id="featured-tabs" role="tablist" aria-label="精選內容">
        <button class="featured-tab" id="featured-covers-tab" type="button" role="tab" aria-selected="true" aria-controls="featured-covers-panel">精選封面</button>
        <button class="featured-tab" id="featured-ads-tab" type="button" role="tab" aria-selected="false" aria-controls="featured-ads-panel" tabindex="-1">精選廣告</button>
      </span>
    </h2>
  ) : (
    <h2 class="section-h">精選封面</h2>
  )}
  <div id="featured-covers-panel" role={adGroups.length > 0 ? 'tabpanel' : undefined} aria-labelledby={adGroups.length > 0 ? 'featured-covers-tab' : undefined}>
    <div class="coverwall" id="coverwall">
      {featured.map(c => (
        <a class="cwall" href={c.u}>
          <img src={c.img} alt={`${c.t} 封面`} loading="lazy" />
          <span class="t">{c.t}</span>
        </a>
      ))}
    </div>
  </div>
  {adGroups.length > 0 && (
    <div id="featured-ads-panel" role="tabpanel" aria-labelledby="featured-ads-tab" hidden>
      <div class="coverwall" id="adwall">
        {featuredAds.map(ad => (
          <a class="cwall" href={ad.u}>
            <img src={ad.img} alt={`${ad.t} 廣告`} loading="lazy" />
            <span class="t">{ad.t}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {recent.length > 0 && (
    <>
      <h2 class="section-h">最近更新</h2>
      <ul class="recent">
        {recent.map(r => (
          <li>
            <span class="tag" data-t={r.type}>{r.emoji} {r.label}</span>
            <a class="lk name" href={r.url}>{r.name}</a>
            {r.sub && <span class="sub">{r.sub}</span>}
            {r.img && <span class="ico" title="含圖資" aria-label="含圖資">📷</span>}
            <time class="date">{r.date}</time>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2 class="section-h">經典系列</h2>
  <div class="cardrow">
    {featSeries.map(s => (
      <div class="scard">
        <div class="t"><a class="lk" href={seriesUrl(s.name)}>{s.name}</a></div>
        <div class="m">{s.range ? `${s.range.min}–${s.range.max}` : ''} · {s.list.length} 款</div>
        <a class="more" href={seriesUrl(s.name)}>查看系列 →</a>
      </div>
    ))}
  </div>

  <h2 class="section-h">依年代</h2>
  <div class="vendrow">
    {decades.map(d => <a class="vend" href={decadeUrl(d.value)}>{d.value} <span class="c">{d.count}</span></a>)}
  </div>

  <p class="browse-more">瀏覽更多：<a class="lk" href={withBase('/companies')}>廠商</a> · <a class="lk" href={withBase('/series')}>系列</a> · <a class="lk" href={withBase('/genres')}>類型</a> · <a class="lk" href={withBase('/people')}>人物</a> · <a class="lk" href={withBase('/topics')}>專題</a></p>

  <script is:inline define:vars={{ pool: coverPool, wallN: WALL_N }}>
    // Weighted sampling without replacement (Efraimidis-Spirakis: key = U^(1/w),
    // take the top-k keys) on each visit, so scarce 原生中文/中文化 covers surface
    // more often than the abundant packaging scans.
    const wall = document.getElementById('coverwall');
    if (wall && pool.length) {
      const pick = pool
        .map(c => ({ c, k: Math.pow(Math.random(), 1 / (c.w || 1)) }))
        .sort((a, b) => b.k - a.k)
        .slice(0, wallN)
        .map(x => x.c);
      const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      wall.innerHTML = pick.map(c =>
        `<a class="cwall" href="${esc(c.u)}"><img src="${esc(c.img)}" alt="${esc(c.t)} 封面" loading="lazy"><span class="t">${esc(c.t)}</span></a>`
      ).join('');
    }
  </script>

  {adGroups.length > 0 && <script id="featured-ad-data" type="application/json" is:inline set:html={adGroupsJson} />}
  <script>
    import { pickFeaturedAds } from '../lib/featuredAds.js';

    const esc = value => String(value).replace(/[&<>"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char]);
    const adData = document.getElementById('featured-ad-data');
    const adwall = document.getElementById('adwall');
    if (adData && adwall) {
      const groups = JSON.parse(adData.textContent || '[]');
      const picked = pickFeaturedAds(groups, 16);
      adwall.innerHTML = picked.map(ad =>
        `<a class="cwall" href="${esc(ad.u)}"><img src="${esc(ad.img)}" alt="${esc(ad.t)} 廣告" loading="lazy"><span class="t">${esc(ad.t)}</span></a>`
      ).join('');
    }

    const tabs = [...document.querySelectorAll('#featured-tabs [role="tab"]')];
    const activateTab = (activeTab, moveFocus = false) => {
      for (const tab of tabs) {
        const active = tab === activeTab;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
      }
      if (moveFocus) activeTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const step = event.key === 'ArrowRight' ? 1 : -1;
        activateTab(tabs[(index + step + tabs.length) % tabs.length], true);
      });
    });
  </script>

  <script>
    const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
    document.getElementById('random')?.addEventListener('click', async () => {
      const g = await (await fetch(`${BASE}/games.json`)).json();
      if (g.length) location.href = `${BASE}/games/${g[Math.floor(Math.random() * g.length)].id}`;
    });
  </script>
</Base>

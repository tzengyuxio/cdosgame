{
  "name": "cdosgame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "中文 DOS 遊戲資料庫 — platform-neutral catalog",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/flatten_sitemap.mjs",
    "preview": "astro preview",
    "test": "node --test 'src/lib/**/*.test.js'",
    "validate": "node scripts/validate_content.mjs",
    "stats": "node scripts/stats.mjs",
    "check:duplicate-links": "node scripts/find_duplicate_game_links.mjs",
    "review": "node scripts/serve_review_state.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.5"
  }
}
